{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run static server",
      "type": "shell",
      "command": "node",
      "args": ["server.js"],
      "problemMatcher": [
        {
          "owner": "static-server",
          "pattern": [
            {
              "regexp": "^(.*)$",
              "file": 1,
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Static server running at",
            "endsPattern": "^$"
          }
        }
      ],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
